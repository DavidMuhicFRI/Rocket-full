@startuml
!pragma layout smetana
skinparam backgroundColor #0B1020
skinparam shadowing false
skinparam roundcorner 18
skinparam defaultFontName Segoe UI
skinparam defaultFontColor #E6EDF3
skinparam componentStyle rectangle
skinparam ArrowColor #A9C1DA
skinparam ArrowThickness 1.8
skinparam component {
  BackgroundColor #172033
  BorderColor #6E8BB7
  FontColor #E6EDF3
}
skinparam package {
  BackgroundColor #101827
  BorderColor #44546A
  FontColor #FFFFFF
}
skinparam note {
  BackgroundColor #1F2937
  BorderColor #7C8AA5
  FontColor #E6EDF3
}

title Reusable Booster Simulator - ownership and data flow

actor User

package "Configuration" {
  [RightConfigPanel\nmodule per tab] as Panel
  [SimulationSessionDraft\neditable + restorable] as Draft
  [SimulationSessionConfig\nvehicle | environment | objective\nlearning | telemetry] as Session
  [SimulationSessionLoader\nread + validate saved run] as Loader
  [VehiclePreviewController\ndraft-only preview] as Preview
}

package "Launch boundary" {
  [SimulationRunCoordinator\nvalidate + choose run path] as Coordinator
  [SimulationSessionSnapshotFactory\nimmutable launch snapshot] as SnapshotFactory
  [SimulationSessionStore\nmanifest + immutable revisions\n+ mutable runtime state] as Store
  [TrainingRunController\nPython process + port handshake] as Training
  [EvaluationRunController\nfixed evaluation suite] as Evaluation
}

package "Runtime area" {
  [SimulationAreaHost\nprivate runtime copy + areas] as Host
  [CurriculumController\ntask router] as Curriculum
  [RocketAssembly\ncomponent coordinator] as Assembly
  [Vehicle components\nbody | engines | fins | RCS | legs] as Components
  [RocketPhysicsConfigFactory\nimmutable physics snapshot] as PhysicsConfig
  [FalconAgent\nlifecycle + policy bridge] as Agent
}

package "Task execution" {
  [Spawning + guidance] as Guidance
  [WindEnvironmentRuntime] as Wind
  [EpisodeFaultRuntime] as Faults
  [Engine + RCS\nactuator state machines] as ActuatorState
  [Landing runtimes\nchopstick | legs] as Landing
  [Reward models\nmeasure -> evaluate -> integrate -> terminate] as Rewards
}

package "Outputs" {
  [TelemetryLogger\nstep + episode data] as Telemetry
  [CSV / JSON results\nmodel resource] as Results
}

User --> Panel : edits
Panel --> Draft : changes one section
Draft --> Session : owns
Draft --> Preview : vehicle/task changes
Store --> Loader : current supported schema
Loader --> Draft : preview import\nrestore on cancel

Panel --> Coordinator : launch request
Draft --> Coordinator : deep copy
Coordinator --> SnapshotFactory : validate + freeze
SnapshotFactory --> Store : save before training
SnapshotFactory --> Host : independent runtime copy
Coordinator --> Training : training only
Coordinator --> Evaluation : standard evaluation only
Training --> Host : spawn when trainer is ready
Evaluation --> Host : spawn inference area

Host --> Curriculum : apply/advance selected task
Host --> Assembly : apply vehicle
Assembly --> Components : each owns layout/presentation
Assembly --> PhysicsConfig : derive mass and authority
Host --> Agent : inject runtime config + model

Agent --> Guidance
Agent --> Wind
Agent --> Faults
Agent --> ActuatorState
Agent --> Landing
Agent --> Rewards
Agent --> Telemetry
PhysicsConfig --> Agent : read-only episode constants
Components --> Agent : force points + visuals\ncontact callbacks
Telemetry --> Results
Store --> Results

note bottom
  The panel owns a mutable draft. Launch is the only boundary that creates a
  frozen snapshot. Active agents receive a private copy and never mutate UI or
  persisted session configuration.
end note

@enduml
