@startuml
!pragma layout smetana
skinparam backgroundColor #0B1020
skinparam shadowing false
skinparam roundcorner 16
skinparam defaultFontName Segoe UI
skinparam defaultFontColor #E6EDF3
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam ArrowColor #9FB3C8
skinparam ArrowThickness 1.4
skinparam component {
  BackgroundColor #172033
  BorderColor #6E8BB7
  FontColor #E6EDF3
}
skinparam package {
  BackgroundColor #101827
  BorderColor #44546A
  FontColor #FFFFFF
}

title Reusable Booster Simulator - source-level architecture

package "UI" {
  [RightConfigPanel.cs\nCore | Session] as RCP
  [Vehicle | Task | Environment\nRewards | Run | ML\nFaults | Telemetry | HardwareTests] as Tabs
  [UIHelper] as UIHelper
  [ConfigBridge] as Bridge
  [RocketCameraController\nRocketHUD] as FlightUI
}

package "Session domain" {
  [SimulationSessionConfig] as SessionConfig
  [SimulationSessionState\nDraft | Snapshot | Manifest] as State
  [SimulationSessionLoader] as Loader
  [SimulationSessionSnapshotFactory] as SnapshotFactory
  [SimulationSessionValidation] as SessionValidation
  [SimulationSessionStore] as Store
}

package "Training and evaluation" {
  [SimulationRunCoordinator] as Coordinator
  [SimulationRunService] as RunService
  [TrainingRunController] as TrainingController
  [TrainingProcessLauncher] as ProcessLauncher
  [TrainingProcessHandle\nprocess lifetime + trainer log] as ProcessHandle
  [EvaluationRunController\nEvaluationSession] as Evaluation
  [ModelRepository] as Models
}

package "Runtime host" {
  [SimulationAreaHost] as Host
  [VehiclePreviewController] as Preview
  [CurriculumController] as Curriculum
  [Task curricula\nHoverTracking | Chopstick | Leg] as TaskCurricula
}

package "Vehicle" {
  [RocketPartsConfig\nHardware types + presets] as VehicleConfig
  [RocketAssembly] as Assembly
  [BodyComponent | ThrusterComponent\nFinComponent | RcsComponent\nLandingLegComponent] as Components
  [RocketPhysicsConfigFactory] as PhysicsFactory
  [RcsHardwareLayout] as RcsLayout
  [RCS geometry + plume presenters] as RcsPresentation
}

package "Agent" {
  [FalconAgent.Core\nlifecycle + policy calls] as AgentCore
  [FalconAgent.Spawning\nFalconAgent.Guidance] as AgentTask
  [FalconAgent.Actuators\nFalconAgent.Physics] as AgentControl
  [FalconAgent.Rewards] as AgentRewards
  [FalconAgent.Telemetry\nFalconAgent.EpisodeReporting] as AgentReporting
  [FalconAgent.ChopstickLanding\nFalconAgent.LegLanding] as LandingBridge
  [RocketAgentSchema] as Schema
}

package "Independent runtimes" {
  [WindEnvironmentRuntime] as Wind
  [EpisodeFaultRuntime] as Faults
  [EngineActuatorStateMachine\nRcsActuatorStateMachine] as ActuatorState
  [AtmosphereModel\nFinAerodynamicsModel\nRocketMassProperties] as PhysicsModels
  [ChopstickLandingRuntime\nLegLandingRuntime] as LandingRuntime
  [LandingFeasibility\nSimulatorPreflightValidator] as Preflight
}

package "Objectives and data" {
  [TrainingObjectiveConfig\nScenarioObjectiveConfig] as Objective
  [RewardParameters\nRewardShapingParameters\nTerminationParameters] as ObjectiveParts
  [RocketRewardModel\nscenario reward models] as RewardModels
  [RewardTerms | RuntimeContext\nDecision | ContributionBuffer] as RewardData
  [TelemetryLogger\nTelemetry pipeline] as Telemetry
}

RCP --> Tabs
Tabs --> UIHelper
Bridge --> RCP : binds
RCP --> State : edits draft
State --> SessionConfig
State --> Preview : restorable preview
Loader --> RunService
Loader --> State : imported session

RCP --> Coordinator : launch
Coordinator --> SnapshotFactory
SnapshotFactory --> SessionValidation
SnapshotFactory --> State : frozen snapshot
Coordinator --> RunService
RunService --> Store
Coordinator --> TrainingController
TrainingController --> ProcessLauncher
ProcessLauncher --> ProcessHandle
Coordinator --> Evaluation
Coordinator --> Host
Host --> Models : inference

Host --> Curriculum
Curriculum --> TaskCurricula
Host --> Assembly
Host --> AgentCore
Host --> Schema
Assembly --> Components
Assembly --> PhysicsFactory
Components --> RcsLayout
Components --> RcsPresentation

AgentCore --> AgentTask
AgentCore --> AgentControl
AgentCore --> AgentRewards
AgentCore --> AgentReporting
AgentCore --> LandingBridge
AgentControl --> Wind
AgentControl --> Faults
AgentControl --> ActuatorState
AgentControl --> PhysicsModels
LandingBridge --> LandingRuntime
AgentTask --> Preflight

SessionConfig --> VehicleConfig
SessionConfig --> Objective
VehicleConfig --> Schema
VehicleConfig --> Assembly
Objective --> ObjectiveParts
AgentRewards --> RewardModels
RewardModels --> RewardData
AgentReporting --> Telemetry
Telemetry --> Store : result folder
FlightUI --> AgentCore : read-only state

note bottom
  RocketSim.Runtime contains product code. RocketSim.EditorTests references the
  runtime assembly; the runtime assembly never references UnityEditor or tests.
end note

@enduml
